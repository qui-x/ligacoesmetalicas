{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:silm:schema:multiphysics-result:1.0.0",
  "title": "SILM Multiphysics Result Snapshot",
  "description": "Snapshot imutável de um instante físico aceito e convergido.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "snapshotId",
    "runId",
    "experimentId",
    "definitionRevision",
    "timeS",
    "accepted",
    "converged",
    "evidenceMode",
    "observables",
    "fieldRefs",
    "balances",
    "provenance",
    "limitations",
    "createdAt"
  ],
  "properties": {
    "schemaId": {
      "const": "silm.multiphysics.result"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^result-[A-Za-z0-9-]{12,80}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9-]{12,80}$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^exp-[A-Za-z0-9-]{12,80}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "timeS": {
      "type": "number",
      "minimum": 0
    },
    "intervalStartS": {
      "type": "number",
      "minimum": 0
    },
    "intervalEndS": {
      "type": "number",
      "minimum": 0
    },
    "accepted": {
      "const": true
    },
    "converged": {
      "const": true
    },
    "evidenceMode": {
      "enum": [
        "parameterized",
        "quantitative"
      ]
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "quantity",
          "value",
          "unit",
          "sourceFieldIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "quantity": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "sourceFieldIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^field-[A-Za-z0-9-]{12,80}$"
            },
            "minItems": 1
          }
        }
      }
    },
    "fieldRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^field-[A-Za-z0-9-]{12,80}$"
      }
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "inputEnergyJ",
          "outputEnergyJ",
          "residualJ",
          "relativeResidual"
        ],
        "properties": {
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "inputEnergyJ": {
            "type": "number"
          },
          "outputEnergyJ": {
            "type": "number"
          },
          "residualJ": {
            "type": "number"
          },
          "relativeResidual": {
            "type": "number",
            "minimum": 0
          },
          "reportId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solverVersions",
        "datasetVersions",
        "lawVersions",
        "mappingVersions",
        "tolerances"
      ],
      "properties": {
        "solverVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "datasetVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "datasetId",
              "version",
              "sourceId"
            ],
            "properties": {
              "datasetId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              }
            }
          }
        },
        "lawVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lawId",
              "version"
            ],
            "properties": {
              "lawId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mappingVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mappingId",
              "version"
            ],
            "properties": {
              "mappingId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relativeTolerance"
          ],
          "properties": {
            "relativeTolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "energyToleranceJ": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
