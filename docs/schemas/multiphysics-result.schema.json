{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:silm:schema:multiphysics-result:1.0.0",
  "title": "SILM Multiphysics Result Snapshot",
  "description": "Snapshot imutável de uma coordenada física aceita e convergida; a coordenada identifica tempo, incremento de carga, frequência ou escala múltipla.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "snapshotId",
    "runId",
    "experimentId",
    "definitionRevision",
    "accepted",
    "converged",
    "evidenceMode",
    "observables",
    "fieldRefs",
    "balances",
    "provenance",
    "limitations",
    "createdAt",
    "coordinate"
  ],
  "properties": {
    "schemaId": {
      "const": "silm.multiphysics.result"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^result-[A-Za-z0-9-]{12,80}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9-]{12,80}$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^exp-[A-Za-z0-9-]{12,80}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "accepted": {
      "const": true
    },
    "converged": {
      "const": true
    },
    "evidenceMode": {
      "enum": [
        "parameterized",
        "quantitative"
      ]
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "quantity",
          "value",
          "unit",
          "sourceFieldIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "quantity": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "sourceFieldIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^field-[A-Za-z0-9-]{12,80}$"
            },
            "minItems": 1
          }
        }
      }
    },
    "fieldRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^field-[A-Za-z0-9-]{12,80}$"
      }
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "inputEnergyJ",
          "outputEnergyJ",
          "residualJ",
          "relativeResidual"
        ],
        "properties": {
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "inputEnergyJ": {
            "type": "number"
          },
          "outputEnergyJ": {
            "type": "number"
          },
          "residualJ": {
            "type": "number"
          },
          "relativeResidual": {
            "type": "number",
            "minimum": 0
          },
          "reportId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solverVersions",
        "datasetVersions",
        "lawVersions",
        "mappingVersions",
        "tolerances"
      ],
      "properties": {
        "solverVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "datasetVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "datasetId",
              "version",
              "sourceId"
            ],
            "properties": {
              "datasetId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              }
            }
          }
        },
        "lawVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lawId",
              "version"
            ],
            "properties": {
              "lawId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mappingVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mappingId",
              "version"
            ],
            "properties": {
              "mappingId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relativeTolerance"
          ],
          "properties": {
            "relativeTolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "energyToleranceJ": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "coordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "timeS"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "timeS": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "incrementIndex",
            "incrementCount",
            "loadFactor"
          ],
          "properties": {
            "kind": {
              "const": "load-increment"
            },
            "incrementIndex": {
              "type": "integer",
              "minimum": 0
            },
            "incrementCount": {
              "type": "integer",
              "minimum": 1
            },
            "loadFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "frequencyHz"
          ],
          "properties": {
            "kind": {
              "const": "frequency"
            },
            "frequencyHz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "timeS",
            "scaleMapId"
          ],
          "properties": {
            "kind": {
              "const": "multiscale-time"
            },
            "timeS": {
              "type": "number",
              "minimum": 0
            },
            "scaleMapId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "timeInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTimeS",
        "endTimeS"
      ],
      "properties": {
        "startTimeS": {
          "type": "number",
          "minimum": 0
        },
        "endTimeS": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
