{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:silm:schema:multiphysics-runtime:1.0.0",
  "title": "SILM Multiphysics Runtime State",
  "description": "Metadados persistidos do último estado aceito de uma execução. A coordenada pode ser tempo físico, incremento quase-estático, frequência ou tempo multiescala. Iterações provisórias não pertencem a este documento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "experimentId",
    "definitionRevision",
    "status",
    "acceptedStep",
    "geometry",
    "meshes",
    "fields",
    "domainReports",
    "updatedAt",
    "acceptedCoordinate"
  ],
  "properties": {
    "schemaId": {
      "const": "silm.multiphysics.runtime"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9-]{12,80}$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^exp-[A-Za-z0-9-]{12,80}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "prepared",
        "running",
        "converged",
        "rejected",
        "interrupted"
      ]
    },
    "acceptedStep": {
      "type": "integer",
      "minimum": 0
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometryId",
        "revision"
      ],
      "properties": {
        "geometryId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "parentRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meshes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meshId",
          "domain",
          "geometryRevision",
          "version"
        ],
        "properties": {
          "meshId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "geometryRevision": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldId",
          "domain",
          "name",
          "meshId",
          "unit",
          "timeS",
          "geometryRevision",
          "storageRef",
          "checksum",
          "valueType"
        ],
        "properties": {
          "fieldId": {
            "type": "string",
            "pattern": "^field-[A-Za-z0-9-]{12,80}$"
          },
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "meshId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "timeS": {
            "type": "number",
            "minimum": 0
          },
          "geometryRevision": {
            "type": "integer",
            "minimum": 0
          },
          "storageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "valueType": {
            "enum": [
              "float32",
              "float64",
              "int32"
            ]
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "maxItems": 4
          }
        }
      }
    },
    "domainReports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "residual",
          "accepted"
        ],
        "properties": {
          "domain": {
            "enum": [
              "electrical",
              "thermal",
              "mechanical",
              "optical"
            ]
          },
          "residual": {
            "type": "number",
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          },
          "balanceReportId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        }
      }
    },
    "lastAcceptedSnapshotId": {
      "type": "string",
      "pattern": "^result-[A-Za-z0-9-]{12,80}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "acceptedCoordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "timeS"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "timeS": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "incrementIndex",
            "incrementCount",
            "loadFactor"
          ],
          "properties": {
            "kind": {
              "const": "load-increment"
            },
            "incrementIndex": {
              "type": "integer",
              "minimum": 0
            },
            "incrementCount": {
              "type": "integer",
              "minimum": 1
            },
            "loadFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "frequencyHz"
          ],
          "properties": {
            "kind": {
              "const": "frequency"
            },
            "frequencyHz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "timeS",
            "scaleMapId"
          ],
          "properties": {
            "kind": {
              "const": "multiscale-time"
            },
            "timeS": {
              "type": "number",
              "minimum": 0
            },
            "scaleMapId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            }
          }
        }
      ]
    }
  }
}
